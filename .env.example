# Core Server
PORT=3001
NODE_ENV=production
OASIS_TRUST_PROXY=1
# cPanel: set startup file to passenger-boot.cjs (exports Express app to Passenger).
# Public URL of this deployment (used by debug self-health checks).
OASIS_PUBLIC_CLOUD_URL=https://your-cpanel-domain.example.com
# Optional hard override for desktop discovery (usually set on license server public-url instead).
OASIS_CLOUD_SERVER_URL=
# Temporary hosted diagnostics: set OASIS_DEBUG_OPEN=1 or OASIS_DEBUG_TOKEN=your-secret
OASIS_DEBUG_OPEN=0
OASIS_DEBUG_TOKEN=

# Security
# Use long, random secrets in production.
JWT_SECRET=replace-with-a-long-random-jwt-secret
OASIS_UID_SECRET=replace-with-a-long-random-uid-secret

# Storage
# For a persistent deployment, point these to your mounted disk/volume paths.
# For serverless or ephemeral hosting, you can use /tmp, but data will not survive restarts.
OASIS_DATA_DIR=./data
OASIS_UPLOADS_DIR=./uploads

# Licensing and plan lookup
OASIS_LICENSE_SERVER_URL=https://oasis-ems-official-license-server-production.up.railway.app
OASIS_LEGACY_LICENSE_SERVER_URL=https://ems-license-server.vercel.app
OASIS_PUBLIC_URL_SERVER=https://ems-license-server.vercel.app
OASIS_PLANS_FETCH_TIMEOUT_MS=6000

OASIS_USE_MYSQL=false

# PayChangu
# Use a `sec-live-...` key for real handset PIN prompts. `sec-test-...` runs in sandbox mode
# and only works with PayChangu's documented mobile money test numbers.
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_SECRET_KEY=replace-with-paychangu-secret-key
# Keep this at 50 for the current Malawi sandbox flow, or set to 0 to charge the real catalog amount.
PAYCHANGU_MALAWI_TEST_AMOUNT=50

# Temporary debugging: set to `true` to show full activation codes/keys in payment logs.
# Existing masked log entries cannot be decrypted retroactively.
PAYMENT_LOG_INCLUDE_FULL_ACTIVATION_CODES=false

# Email / SMTP (MAIL_* preferred; SMTP_* still supported as fallback)
MAIL_MAILER=smtp
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_USERNAME=hello@emsoasis.online
MAIL_PASSWORD=replace-with-mail-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@emsoasis.online
MAIL_FROM_NAME=Oasis-CI
SMTP_SECURE=true
# Legacy aliases (optional if MAIL_* is set)
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=hello@emsoasis.online
SMTP_PASS=replace-with-mail-password
SMTP_FROM=hello@emsoasis.online

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
# Multi-school cloud storage: each migrated school gets its own database.
# Use MYSQL_DATABASE_PREFIX only. Do NOT set MYSQL_DATABASE alone — that legacy mode
# routed every school into one database and overwrote previous migrations.
MYSQL_DATABASE_PREFIX=oasis_ems
# MYSQL_DATABASE=legacy_single_db_name
MYSQL_CHARSET=utf8mb4
