# Core Server
PORT=3001
NODE_ENV=production

# Security
# Use long, random secrets in production.
JWT_SECRET=replace-with-a-long-random-jwt-secret
OASIS_UID_SECRET=replace-with-a-long-random-uid-secret

# Storage
# For a persistent deployment, point these to your mounted disk/volume paths.
# For serverless or ephemeral hosting, you can use /tmp, but data will not survive restarts.
OASIS_DATA_DIR=./data
OASIS_UPLOADS_DIR=./uploads

# Licensing and plan lookup
OASIS_LICENSE_SERVER_URL=https://oasis-ems-official-license-server-production.up.railway.app
OASIS_LEGACY_LICENSE_SERVER_URL=https://ems-license-server.vercel.app
OASIS_PUBLIC_URL_SERVER=https://ems-license-server.vercel.app
OASIS_PLANS_FETCH_TIMEOUT_MS=6000

# PayChangu
# Use a `sec-live-...` key for real handset PIN prompts. `sec-test-...` runs in sandbox mode
# and only works with PayChangu's documented mobile money test numbers.
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_SECRET_KEY=replace-with-paychangu-secret-key
# Keep this at 50 for the current Malawi sandbox flow, or set to 0 to charge the real catalog amount.
PAYCHANGU_MALAWI_TEST_AMOUNT=50

# Temporary debugging: set to `true` to show full activation codes/keys in payment logs.
# Existing masked log entries cannot be decrypted retroactively.
PAYMENT_LOG_INCLUDE_FULL_ACTIVATION_CODES=false

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
