# Server Configuration
PORT=3001

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=oasis-super-secret-jwt-key-valid-for-production-2024

# Node Environment
NODE_ENV=development

# SQLite/Data location (for serverless use /tmp)
OASIS_DATA_DIR=/tmp/oasis-data
OASIS_UPLOADS_DIR=/tmp/oasis-uploads

# Required for app identity encryption
OASIS_UID_SECRET=replace-with-strong-random-secret

# Optional override for the official license service
OASIS_LICENSE_SERVER_URL=https://oasis-ems-official-license-server-production.up.railway.app
